ARG CI_BASE_IMAGE=quay.io/centos/centos:stream10
FROM ${CI_BASE_IMAGE}

# Значения по умолчанию применяются, если build-arg не передан.
# Пустая строка или "false" означают «не устанавливать».
ARG WIDTH_KERNEL=""
ARG WIDTH_DKMS=false
ARG WIDTH_BASE_PACKAGES="mc git make curl wget libmnl-devel pkgconf fail2ban firewalld firewalld-filesystem nftables python3 python3-pip python3-virtualenv qrencode"

LABEL maintainer="vados-dev"
LABEL com.docker.compose.service="amneziawg-ci-runner"
LABEL com.docker.compose.project="amneziawg-ci"

RUN set -eux; dnf check-update -y > /dev/null 2>&1 || true ;
RUN set -eux; dnf -y install dnf-plugins-core || true
RUN set -eux; dnf config-manager --set-enabled crb || true ; dnf check-update -y > /dev/null 2>&1 || true ;
RUN set -eux; dnf -y install epel-release || true ; dnf check-update -y > /dev/null 2>&1 || true ;

# WIDTH_KERNEL — точная версия ядра, например 6.12.0-273.el10.x86_64.
RUN if [ -n "$WIDTH_KERNEL" ] && [ "$WIDTH_KERNEL" != "false" ]; then \
        set -eux; \
        dnf -y install "kernel-headers-${WIDTH_KERNEL}" "kernel-devel-${WIDTH_KERNEL}" ; \
    fi
RUN if [ "$WIDTH_DKMS" = "true" ]; then \
        set -eux; \
        os_ver="$(rpm -E '%{rhel}' 2>/dev/null || true)"; \
        case "$os_ver" in ''|*[!0-9]*) os_ver=10 ;; esac; \
        arch="$(uname -m)"; \
        dnf copr enable -y tigro/amneziawg "centos-stream-${os_ver}-${arch}" || true ; \
        dnf clean all || true ; dnf makecache || true ; \
        dnf -y install amneziawg-tools amneziawg-dkms ; \
    fi

RUN set -eux; dnf -y update || true

# Список пакетов передаётся через пробел, поэтому word splitting нужен намеренно.
RUN if [ -n "$WIDTH_BASE_PACKAGES" ] && [ "$WIDTH_BASE_PACKAGES" != "false" ]; then \
        set -eux; \
        dnf -y install $WIDTH_BASE_PACKAGES ; \
    fi

COPY internal/ci-image/mc.tar.gz /tmp/mc.tar.gz
RUN set -eux; \
    mkdir -p /root/.config "${HOME}/.config"; \
    tar -xzf /tmp/mc.tar.gz -C /root/.config; \
    tar -xzf /tmp/mc.tar.gz -C "${HOME}/.config"; \
    chown -R root:root /root/.config; \
    rm -f /tmp/mc.tar.gz

WORKDIR /work

ENV HOME=/work/.ci-home
ENV USER=git
ENV LOGNAME=git
