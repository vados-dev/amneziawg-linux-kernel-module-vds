ARG CI_BASE_IMAGE=quay.io/centos/centos:stream10
FROM ${CI_BASE_IMAGE}

# Значения по умолчанию применяются, если build-arg не передан.
# Пустая строка или "false" означают «не устанавливать».
ARG WIDTH_KERNEL=""
ARG WIDTH_DKMS=false
ARG WIDTH_INITRAMFS=false
ARG WIDTH_BASE_PACKAGES="gcc make git tar gzip which curl wget libmnl-devel pkgconf python3 python3-pip dkms"

LABEL maintainer="vados-dev"
LABEL com.docker.compose.service="amneziawg-ci-runner"
LABEL com.docker.compose.project="amneziawg-ci"

RUN set -eux; \
    dnf -y install dnf-plugins-core; \
    dnf config-manager --set-enabled crb appstream; \
    dnf -y install epel-release kernel-srpm-macros; \
    dnf clean all

# Ядро. Для сборки модуля достаточно kernel + kernel-devel(-matched) + kernel-headers:
# /lib/modules/<ver>/build появляется из kernel-devel, depmod от dkms-install
# отрабатывает по модулям из kernel/kernel-modules.
# WIDTH_KERNEL — точная версия, напр. 6.12.0-281.el10.x86_64 (пусто = последний из репо).
RUN set -eux; \
    if [ -n "$WIDTH_KERNEL" ] && [ "$WIDTH_KERNEL" != "false" ]; then \
        kver="$WIDTH_KERNEL"; \
        pkgs="kernel-${kver} kernel-core-${kver} kernel-modules-${kver} kernel-modules-core-${kver} \
              kernel-devel-${kver} kernel-devel-matched-${kver} kernel-headers-${kver}"; \
    else \
        pkgs="kernel kernel-core kernel-modules kernel-modules-core \
              kernel-devel kernel-devel-matched kernel-headers"; \
    fi; \
    dnf -y install ${pkgs}; \
    dnf clean all

# initramfs нужен только для bootable-образа; в CI-контейнере не используется.
RUN set -eux; \
    if [ "$WIDTH_INITRAMFS" = "true" ]; then \
        dracut -f --kver "$(ls /usr/lib/modules | sort -V | tail -1)" /boot/initramfs-custom.img; \
    fi; \
    dnf clean all

# Опционально: готовый amneziawg-tools/dkms из copr (обычно не нужно для CI).
RUN set -eux; \
    if [ "$WIDTH_DKMS" = "true" ]; then \
        os_ver="$(rpm -E '%{rhel}' 2>/dev/null || true)"; \
        case "$os_ver" in ''|*[!0-9]*) os_ver=10 ;; esac; \
        arch="$(uname -m)"; \
        dnf copr enable -y tigro/amneziawg "centos-stream-${os_ver}-${arch}"; \
        dnf clean all; dnf makecache; \
        dnf -y install amneziawg-tools amneziawg-dkms; \
    fi; \
    dnf clean all

# Список пакетов передаётся через пробел, поэтому word splitting нужен намеренно.
# shellcheck disable=SC2086
RUN set -eux; \
    if [ -n "$WIDTH_BASE_PACKAGES" ] && [ "$WIDTH_BASE_PACKAGES" != "false" ]; then \
        dnf -y install $WIDTH_BASE_PACKAGES; \
    fi; \
    dnf clean all

WORKDIR /work

ENV HOME=/work/.ci-home
ENV USER=git
ENV LOGNAME=git
